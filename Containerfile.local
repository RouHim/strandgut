FROM ghcr.io/rust-cross/rust-musl-cross:x86_64-musl AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY assets ./assets
COPY src ./src

RUN cargo build --release --target x86_64-unknown-linux-musl

FROM docker.io/debian:bookworm-slim

ENV DATA_FOLDER="/data"
ENV RUST_LOG="info"  # Controls log level (env_logger)

VOLUME /data

WORKDIR /data

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data /tmp \
    && chmod 1777 /tmp \
    && chown -R 1000:1000 /data /tmp

COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/strandgut /strandgut

EXPOSE 13569
USER 1000:1000

ENTRYPOINT ["/strandgut"]
